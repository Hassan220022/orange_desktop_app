; Import Linter configuration — enforces architectural boundaries for v2.
;
; Layer order (top = highest, may import downward):
;     services -> adapters -> qml -> ui -> db -> data -> core
;
; services is the only place allowed to talk to sqlalchemy/duckdb.

[importlinter]
root_packages =
    services
    ui
    db
    data
    core
include_external_packages = True

[importlinter:contract:1]
; Loose declaration of the layered architecture.  (adapters) and (qml) are
; marked optional because those packages have not been created yet — they
; belong to later v2 sub-projects.  Re-introduce them without parentheses
; when the packages exist on disk.
name = Layered architecture (loose ordering)
type = layers
layers =
    services
    (adapters)
    (qml)
    ui
    db
    data
    core

[importlinter:contract:2]
; services must not import from the UI / QML / adapter layers.
; (adapters) and (qml) cannot be listed here yet because import-linter
; requires forbidden modules to exist on disk; they will be added to this
; contract once those packages are introduced in later v2 sub-projects.
name = Services must not import from UI / adapters / QML
type = forbidden
source_modules =
    services
forbidden_modules =
    ui

[importlinter:contract:3]
; Only services.persistence may import SQLAlchemy or DuckDB.  Every other
; top-level package is forbidden from importing them.  We enumerate each
; layer explicitly because import-linter has no exempt_modules field;
; services.persistence is omitted from source_modules so it is allowed to
; import freely.
name = Only services.persistence may import SQLAlchemy / DuckDB
type = forbidden
source_modules =
    ui
    db
    data
    core
forbidden_modules =
    sqlalchemy
    duckdb
