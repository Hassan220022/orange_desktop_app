# ── Virtual environment ──────────────────────────────────────
.venv/
.venv_build/

# ── Python cache & compiled files ────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb

# ── PyInstaller / build output ───────────────────────────────
/build/
/dist/
*.spec

# ── Data files (keep out of version control) ─────────────────
*.xlsx
*.csv
*.xls
*.db
# Allow test fixtures to be tracked
!tests/fixtures/*.xlsx
!tests/fixtures/*.csv
!tests/fixtures/*.xls
!tests/fixtures/*.py
!tests/fixtures/*.jsonl

# ── Local runtime/generated app data ──────────────────────────
bdt_storage/
dist_ci/
alarm_web.db

# ── Log files (generated at runtime) ─────────────────────────
/logs/*.log
/logs/*.log.*
!/logs/.gitkeep

# ── Web stack runtime secrets/config ──────────────────────────
web/deploy/env/backend.env
web/frontend/.env
web/frontend/.env.local
web/frontend/.env.production

# ── macOS metadata & resource forks ──────────────────────────
.DS_Store
._*

# ── IDE / editor ─────────────────────────────────────────────
.vscode/

# ── Claude Code internal state ───────────────────────────────
.claude/
.mcp.json

# ── Axon graph database ─────────────────────────────────────
.axon/
# ── Repo-local CI/build helper files not for upstream ─────────
.github/*
!.github/workflows/
!.github/workflows/*.yml
.env

# Stakpak local files
.stakpak/session*
